# --- Required ---------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Models (cheap default, stronger fallback) ------------------------------
GEMINI_PRIMARY_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Escalate to the fallback model when the primary's self-reported confidence is below this
ESCALATION_CONFIDENCE=0.8

# --- Database (optional but recommended) ------------------------------------
# Add Neon from the Vercel Marketplace (free tier) and it sets this for you.
# Without it the app runs on an in-memory store that resets on every cold start.
DATABASE_URL=

# --- Integrations (all optional) --------------------------------------------
# Where approved documents are posted. Defaults to this app's own /api/mock-erp.
ERP_WEBHOOK_URL=
# Shared secret sent as the X-Webhook-Secret header to the ERP endpoint
ERP_WEBHOOK_SECRET=change-me
# Slack or Discord incoming webhook for approval notifications
NOTIFY_WEBHOOK_URL=
# n8n webhook trigger URL (see n8n/approval-workflow.json)
N8N_WEBHOOK_URL=

# --- Demo protection --------------------------------------------------------
# Live Gemini extractions allowed per visitor IP per day
LIVE_EXTRACTIONS_PER_DAY=5
